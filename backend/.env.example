# Copy this file to .env and fill in the values. .env is ignored by git.

# CardSight AI key, for "Create deck from photo".
CARDSIGHTAI_API_KEY=

# Postgres connection string. Holds the cards and your decks.
# This matches the local database from docker-compose.yml. If you installed
# Postgres yourself, use your own user, password and database name.
DATABASE_URL=postgresql://optcg:optcg@localhost:5432/optcg
