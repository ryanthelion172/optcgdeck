# Copy this file to .env and fill in the values. .env is ignored by git.

# CardSight AI key, for "Create deck from photo".
CARDSIGHTAI_API_KEY=

# Neon Postgres connection string, for saving decks online.
# Neon dashboard > your project > Connect, e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
